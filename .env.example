# Copiar a .env y completar localmente. Nunca guardar credenciales en Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Hermosillo

POSTGRES_DB=atencion_ciudadana
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Base exclusiva preparada previamente; usar config.settings_test y --keepdb.
# Credenciales independientes: no se reutilizan POSTGRES_USER ni POSTGRES_PASSWORD.
TEST_POSTGRES_DB=test_atencion_catalogos_revision
TEST_POSTGRES_USER=atencion_test
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_HOST=127.0.0.1
TEST_POSTGRES_PORT=5432
